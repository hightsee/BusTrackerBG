JWT_SECRET=your_jwt_secret_here
APP_ENV=local
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=5000
RATE_LIMIT_STORAGE_URI=memory://
TRUST_PROXY=false
# Prefer a directory outside the source checkout for runtime SQLite files.
# Example: DATA_DIR=../BusTrackerBG-data
DATA_DIR=
APP_DATA_DB=app_data.db
GTFS_DB=gtfs.db
GTFS_UPDATE_INTERVAL_DAYS=7
GTFS_UPDATE_HOUR=3
GTFS_UPDATE_MINUTE=0
BGPREVOZ_UPDATE_ENABLED=true
BGPREVOZ_UPDATE_INTERVAL_DAYS=1
BGPREVOZ_UPDATE_HOUR=4
BGPREVOZ_UPDATE_MINUTE=30
BGPREVOZ_IMPORT_DELAY_SECONDS=0.2
GTFS_MAX_DOWNLOAD_BYTES=134217728
GTFS_MAX_UNCOMPRESSED_BYTES=536870912
GTFS_MAX_FILE_BYTES=268435456
